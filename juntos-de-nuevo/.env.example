APP_NAME="Juntos de Nuevo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# Database (MySQL 8)
#
# The main schema is NOT created by `php artisan migrate`. Create the
# database yourself and import the SQL scripts in docs/ before running
# the app for the first time -- see the README.
# ----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=juntos_de_nuevo
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------------------------
# Session, cache and queue
#
# The `database` drivers need the `sessions`, `cache` and `jobs` tables,
# which docs/laravel-aux-tables.sql creates.
# ----------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# ----------------------------------------------------------------------
# Transactional email
#
# Besides Laravel's own mailers, config/mail.php defines two custom SMTP
# mailers: `brevo` (used in production) and `mailjet`. Keep MAIL_MAILER=log
# in local development to write emails to the log instead of sending them.
# ----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@juntosdenuevo.org"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo (MAIL_MAILER=brevo). Host and port are fixed in config/mail.php
# (smtp-relay.brevo.com:587); the API key is used as both SMTP username
# and password.
BREVO_API_KEY=

# Mailjet (MAIL_MAILER=mailjet)
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Plain SMTP (MAIL_MAILER=smtp)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null

VITE_APP_NAME="${APP_NAME}"
